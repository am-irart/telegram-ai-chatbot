# Telegram AI Chatbot Configuration

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Gemini API Keys (comma-separated for rotation)
GEMINI_API_KEYS=key1,key2,key3,key4

# VPN Configuration (optional)
# Set to true if using VPN
USE_VPN=false
VPN_PROXY_URL=

# Whitelist Configuration
WHITELIST_ENABLED=false
# Format: comma-separated user IDs
WHITELIST_USERS=123456789,987654321
# Format: comma-separated group IDs (negative numbers)
WHITELIST_GROUPS=-100111111111,-100222222222

# Admin Configuration
ADMIN_IDS=123456789,987654321

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_PERIOD_HOURS=1

# Conversation History
MAX_HISTORY_LENGTH=10

# Database
DATABASE_PATH=chatbot.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Gemini Model Settings
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048

# Timeout Settings (seconds)
REQUEST_TIMEOUT=30
GEMINI_REQUEST_TIMEOUT=60
